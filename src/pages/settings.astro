---
import Base from '../layouts/Base.astro';
import { APP } from '../config';
---
<Base tab="settings" title="Settings">
  <div class="head"><h1 class="h h2">Settings &amp; backup</h1><p class="sub">Your progress lives only in this browser on this device. Export a backup now and then.</p></div>
  <div class="sec" style="border-top:1px solid var(--rule)">
    <div class="set"><div><p class="t">New review cards per day</p><p class="s">On the Review tab, the 7-day miss rate tells you: under 5%, raise this; over 15%, lower it.</p></div>
      <div class="seg" id="npd">{[5, 10, 15, 20, 30].map((n) => <button data-v={n} aria-pressed="false">{n}</button>)}</div></div>
    <div class="set"><div><p class="t">Theme</p><p class="s">Auto follows your phone's setting.</p></div>
      <div class="seg" id="theme">{[['auto', 'Auto'], ['light', 'Light'], ['dark', 'Dark']].map(([v, l]) => <button data-v={v} aria-pressed="false">{l}</button>)}</div></div>
    <div class="set"><div><p class="t">Add to your home screen</p><p class="s">iPhone: open in Safari, tap Share, then “Add to Home Screen”. Android: “Install app” in the Chrome menu. After the first visit it works offline.</p></div><button class="btn pri" id="install" hidden>Install {APP.name}</button></div>
    <div class="set"><div><p class="t">Backup</p><p class="s">One file with everything: review schedule, passes, cases, lessons, activity.</p></div>
      <div class="pair" style="margin-top:0"><button class="btn quiet" id="export">Export</button><label class="btn quiet" for="file">Import</label></div><input type="file" id="file" accept="application/json,.json" hidden></div>
    <div class="set"><div><p class="t">Clear my progress</p><p class="s">Cannot be undone. Export first.</p></div>
      <button class="btn fail" id="reset">Clear progress</button><button class="btn fail" id="reset-yes" hidden>Yes, clear everything</button></div>
  </div>
  <div class="sec"><div class="sh">About the content</div>
    <p class="small" style="margin-bottom:10px"><b>Logs are simplified.</b> They were written for teaching and are not output from any real tool.</p>
    <p class="small" style="margin-bottom:10px"><b>How lessons are checked.</b> “Checked” lessons were written from the 3GPP specification text (Release 17) and show their spec trail. “Practice” lessons are engineering practice; any spec facts in them are checked. Open questions are listed in the project's CONTENT_GAPS file.</p>
    <p class="small"><b>The satellite chapter is reasoning.</b> It works from physics and public information, not from any vendor's design.</p>
  </div>
  <script>
    import { state, save, normalize, replace, applyTheme, blank } from '../scripts/store';
    import { $$, toast, pad2 } from '../scripts/util';
    const paint = () => { for (const b of $$('#npd button')) b.setAttribute('aria-pressed', String(+b.dataset.v! === state.set.newPerDay)); for (const b of $$('#theme button')) b.setAttribute('aria-pressed', String(b.dataset.v === (state.set.theme || 'auto'))); };
    for (const b of $$('#npd button')) b.addEventListener('click', () => { state.set.newPerDay = +b.dataset.v!; save(); paint(); });
    for (const b of $$('#theme button')) b.addEventListener('click', () => { state.set.theme = b.dataset.v!; applyTheme(); save(); paint(); });
    document.getElementById('export')!.addEventListener('click', () => {
      const d = new Date(), a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([JSON.stringify(state, null, 1)], { type: 'application/json' }));
      a.download = `uu-backup-${d.getFullYear()}${pad2(d.getMonth() + 1)}${pad2(d.getDate())}.json`;
      document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 2000); toast('Backup file saved');
    });
    document.getElementById('file')!.addEventListener('change', (e) => {
      const f = (e.target as HTMLInputElement).files?.[0]; if (!f) return;
      const r = new FileReader();
      r.onload = () => { try { const d = JSON.parse(String(r.result)); if (!d || d.v !== 1 || typeof d.r !== 'object') throw 0; replace(normalize(d)); applyTheme(); save(); paint(); toast('Backup imported'); } catch { toast('That file is not a backup from this app'); } };
      r.readAsText(f);
    });
    const reset = document.getElementById('reset')!, yes = document.getElementById('reset-yes')!;
    reset.addEventListener('click', () => { reset.hidden = true; yes.hidden = false; });
    yes.addEventListener('click', () => { replace(blank()); applyTheme(); save(); paint(); yes.hidden = true; reset.hidden = false; toast('Progress cleared'); });
    let evt: (Event & { prompt: () => void }) | null = null;
    window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); evt = e as typeof evt; document.getElementById('install')!.hidden = false; });
    document.getElementById('install')!.addEventListener('click', () => { evt?.prompt(); evt = null; });
    paint();
  </script>
</Base>
