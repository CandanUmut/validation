---
import Base from '../../layouts/Base.astro';
import { modules, lessons, terms } from '../../lib/data';
import { u } from '../../lib/url';
const ls = await lessons();
const mods = (await modules()).map((m) => ({ ...m, ids: ls.filter((l) => l.module === m.id).map((l) => l.id) }));
const termCount = (await terms()).length;
---
<Base tab="library" title="Library">
  <div class="head">
    <span class="eyebrow">Library · <b id="read">0</b> / {ls.length} read</span>
    <h1 class="h h1">Library</h1>
    <p class="sub">Read when a step or a card does not make sense yet. Reading is for understanding; the other tabs are for remembering.</p>
  </div>
  <div class="sec" id="spec"></div>
  <div class="sec" style="border-top:1px solid var(--rule)">
    {mods.map((m) => (
      <a class="mod" href={u(`library/${m.id}/`)} data-mod={m.id} data-ids={m.ids.join(',')}>
        <span class="t">{m.title}</span>
        <span class="s">{m.summary}</span>
        <span class="c"><span class="k">0</span>/{m.ids.length}</span>
        <div class="meter"><span style="width:0"></span></div>
      </a>
    ))}
    <a class="mod" href={u('library/terms/')}><span class="t">Terms</span><span class="s">Every abbreviation and name, with a plain meaning.</span><span class="c">{termCount}</span></a>
  </div>
  <script type="application/json" id="d-mods" set:html={JSON.stringify(mods.map((m) => ({ code: m.code, title: m.title, ids: m.ids })))} />
  <script>
    import { state } from '../../scripts/store';
    import { spectrum } from '../../scripts/draw';
    import { $$, data } from '../../scripts/util';
    const mods = data<{ code: string; title: string; ids: string[] }[]>('d-mods');
    let read = 0;
    for (const a of $$('[data-mod]')) {
      const ids = a.dataset.ids!.split(','), k = ids.filter((id) => state.lessons[id]).length; read += k;
      a.querySelector('.k')!.textContent = String(k);
      (a.querySelector('.meter span') as HTMLElement).style.width = (k / ids.length) * 100 + '%';
    }
    document.getElementById('read')!.textContent = String(read);
    document.getElementById('spec')!.innerHTML = '<div class="sh">Coverage</div>' + spectrum(mods.map((m) => ({ code: m.code, title: m.title, frac: m.ids.filter((id) => state.lessons[id]).length / m.ids.length }))) + '<p class="note" style="margin-top:6px">Band height is the share of each module you have read.</p>';
  </script>
</Base>
